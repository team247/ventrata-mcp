# Ventrata OCTO API Configuration
# Copy to .env and set your actual API key.
VENTRATA_API_KEY=your-api-key-here
VENTRATA_BASE_URL=https://api.ventrata.com/octo
# Comma-separated OCTO capabilities — default includes the ones this server uses for read-only data
# Full list of capabilities: https://docs.ventrata.com/getting-started/request-capabilities
VENTRATA_CAPABILITIES=octo/pricing,octo/content,octo/cart,octo/questions,octo/offers,octo/cardPayments
